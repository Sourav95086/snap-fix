<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED -->

    <item android:state_pressed="true">

        <shape>

            <solid
                android:color="#102C35" />

            <stroke
                android:width="1dp"
                android:color="#00B8CC" />

            <corners
                android:radius="9dp" />

        </shape>

    </item>


    <!-- NORMAL -->

    <item>

        <shape>

            <solid
                android:color="#0B171F" />

            <stroke
                android:width="1dp"
                android:color="#00E5FF" />

            <corners
                android:radius="9dp" />

        </shape>

    </item>

</selector>