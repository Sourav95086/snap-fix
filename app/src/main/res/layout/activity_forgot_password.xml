<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B12"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CLEARANCE ENCRYPTED // RECOVERY"
        android:textColor="#00E5FF"
        android:textSize="8sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="△"
            android:textColor="#00E5FF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ACCESS KEY RECOVERY"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Transmit recovery instructions to your registered email"
            android:textColor="#8995A3"
            android:textSize="8sp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_auth_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTERED OPERATOR EMAIL"
            android:textColor="#AAB4C0"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="  EMAIL@SECURE.NET"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66717E"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_cyan_button"
            android:text="SEND RESET TRANSMISSION  →"
            android:textColor="#001018"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

    </LinearLayout>


    <TextView
        android:id="@+id/backToLoginText"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_secondary_button"
        android:gravity="center"
        android:text="← RETURN TO AUTHENTICATION"
        android:textColor="#B9C3CE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>