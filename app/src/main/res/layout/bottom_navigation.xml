<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_bottom_navigation">

    <!-- MAP -->

    <LinearLayout
        android:id="@+id/navMap"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/navIcon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_map"
            android:contentDescription="Map"/>

        <TextView
            android:id="@+id/navText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="MAP"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- DEMOGRAPHICS -->

    <LinearLayout
        android:id="@+id/navDemographics"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/navIcon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_demographics"
            android:contentDescription="Demographics"/>

        <TextView
            android:id="@+id/navText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="DEMOGRAPHICS"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- SOLUTIONS -->

    <LinearLayout
        android:id="@+id/navSolutions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/navIcon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_solutions"
            android:contentDescription="Solutions"/>

        <TextView
            android:id="@+id/navText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="SOLUTIONS"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>