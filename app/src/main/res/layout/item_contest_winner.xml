<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/contest_winner_card"
    android:layout_marginBottom="10dp">


    <!-- ============================================= -->
    <!-- TOP ROW -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <!-- RANK -->

        <TextView
            android:id="@+id/rankText"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="#1"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/contest_rank_bg"/>


        <!-- NAME -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="11dp">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sourav"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/phoneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+91 9876540001"
                android:textColor="#7C91A6"
                android:textSize="10sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>


        <!-- REPORT COUNT -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/reportCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:textColor="#00E5FF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPORTS"
                android:textColor="#62788D"
                android:textSize="8sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ============================================= -->
    <!-- DIVIDER -->
    <!-- ============================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A2C3D"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"/>


    <!-- ============================================= -->
    <!-- EMAIL -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textColor="#526A7E"
            android:textSize="8sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/emailText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="sourav95086@gmail.com"
            android:textColor="#B4C5D4"
            android:textSize="10sp"/>

    </LinearLayout>


    <!-- ============================================= -->
    <!-- MOST REPORTED CATEGORY -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="9dp">

        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textColor="#526A7E"
            android:textSize="8sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/categoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Road Infrastructure"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/contest_category_bg"/>

    </LinearLayout>


    <!-- ============================================= -->
    <!-- REWARD -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="9dp">

        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="REWARD"
            android:textColor="#526A7E"
            android:textSize="8sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/rewardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amazon Gift Card"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>