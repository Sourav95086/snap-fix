<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#0B1220"

    android:fillViewport="true"

    android:scrollbars="none">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="15dp"
        android:paddingTop="52dp"
        android:paddingEnd="15dp"
        android:paddingBottom="30dp">


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="ANALYTICAL DASHBOARD"

            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"

            android:text="Bhubaneswar • Civic Intelligence"

            android:textColor="#7F8A9A"
            android:textSize="9sp"/>


        <!-- ===================================================== -->
        <!-- OVERVIEW                                              -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:text="OVERVIEW"

            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>


        <!-- ===================================================== -->
        <!-- STAT CARDS                                             -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:orientation="horizontal">


            <!-- REPORTS -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="72dp"

                android:layout_weight="1"

                android:background="#141A27"

                android:gravity="center"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="REPORTS"

                    android:textColor="#697585"
                    android:textSize="7sp"/>


                <TextView
                    android:id="@+id/totalReportsText"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="--"

                    android:textColor="#00D9FF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- CATEGORIES -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="72dp"

                android:layout_marginStart="6dp"

                android:layout_weight="1"

                android:background="#141A27"

                android:gravity="center"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="CATEGORIES"

                    android:textColor="#697585"
                    android:textSize="7sp"/>


                <TextView
                    android:id="@+id/categoryCountText"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="--"

                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- AVG WEIGHT -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="72dp"

                android:layout_marginStart="6dp"

                android:layout_weight="1"

                android:background="#141A27"

                android:gravity="center"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="AVG WEIGHT"

                    android:textColor="#697585"
                    android:textSize="7sp"/>


                <TextView
                    android:id="@+id/avgWeightText"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="--"

                    android:textColor="#FACC15"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ISSUE DISTRIBUTION                                    -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:text="ISSUE DISTRIBUTION"

            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="250dp"

            android:layout_marginTop="8dp"

            android:background="#141A27"

            android:gravity="center"

            android:orientation="vertical">


            <com.nextgenius.snapfix.PieChartView
                android:id="@+id/pieChartView"

                android:layout_width="235dp"
                android:layout_height="235dp"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- PIE LEGEND                                            -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:background="#141A27"

            android:orientation="vertical"

            android:padding="11dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="CATEGORY BREAKDOWN"

                android:textColor="#697585"
                android:textSize="7sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/pieLegendContainer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:orientation="vertical"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MOST IMPORTANT ISSUE                                  -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:background="#141A27"

            android:orientation="vertical"

            android:padding="12dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="MOST IMPORTANT ISSUE"

                android:textColor="#697585"
                android:textSize="7sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/topIssueText"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Loading..."

                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- TOP ISSUES                                            -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="TOP ISSUES"

            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>


        <LinearLayout
            android:id="@+id/issueListContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:orientation="vertical"/>


        <!-- ===================================================== -->
        <!-- SOLUTIONS                                             -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="SOLUTION PRIORITIES"

            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>


        <LinearLayout
            android:id="@+id/solutionListContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:orientation="vertical"/>


        <!-- ===================================================== -->
        <!-- WARD INFORMATION                                      -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="WARD INFORMATION"

            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"

            android:text="Priority overview by selected wards"

            android:textColor="#697585"
            android:textSize="8sp"/>


        <LinearLayout
            android:id="@+id/wardContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:orientation="vertical"/>


    </LinearLayout>

</ScrollView>