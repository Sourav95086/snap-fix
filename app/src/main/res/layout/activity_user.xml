<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080B10">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:background="#0C1118"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SNAPFIX"
                android:textColor="#00D9FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="CITIZEN PORTAL"
                android:textColor="#687586"
                android:textSize="8sp"
                android:fontFamily="monospace" />

            <!-- HAMBURGER -->

            <TextView
                android:id="@+id/hamburgerButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#00D9FF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SCROLL AREA -->
        <!-- ===================================================== -->

        <ScrollView
            android:id="@+id/userScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">


                <!-- ================================================= -->
                <!-- PROFILE CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:background="@drawable/bg_user_profile">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CITIZEN REPORTER"
                        android:textColor="#00D9FF"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Loading..."
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userEmailText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="user@email.com"
                        android:textColor="#6E7B8C"
                        android:textSize="9sp"
                        android:fontFamily="monospace" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- STATS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">


                    <!-- REPORTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_user_stat">

                        <TextView
                            android:id="@+id/reportCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#00D9FF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="ISSUES REPORTED"
                            android:textColor="#788596"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>


                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />


                    <!-- POINTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_user_stat">

                        <TextView
                            android:id="@+id/pointsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#A855F7"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="CIVIC POINTS"
                            android:textColor="#788596"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- PREVIOUS CONTEST -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/contestStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PREVIOUS CONTEST • RESULTS"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SWIPE →"
                            android:textColor="#00D9FF"
                            android:textSize="7sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>


                    <!-- Contest cards are added here from Java -->

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/contestContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingEnd="5dp" />

                    </HorizontalScrollView>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- USER ISSUES -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="YOUR REPORTS"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE"
                            android:textColor="#00D9FF"
                            android:textSize="7sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>


                    <!-- All issue cards are added here from Java -->

                    <LinearLayout
                        android:id="@+id/issuesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical" />

                </LinearLayout>


                <!-- BOTTOM SPACE -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="25dp" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================================= -->
    <!-- NEON NAVIGATION DRAWER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/userNavigationDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#090D14"
        android:elevation="20dp">


        <!-- ===================================================== -->
        <!-- DRAWER HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="22dp"
            android:background="#0C1118">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SNAPFIX"
                android:textColor="#00D9FF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="CITIZEN CONTROL"
                android:textColor="#788596"
                android:textSize="9sp"
                android:fontFamily="monospace" />

            <View
                android:layout_width="65dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="#00D9FF" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MENU HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:text="OPERATIONS"
            android:textColor="#526071"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />


        <!-- ===================================================== -->
        <!-- VALIDATE ISSUE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navValidateIssue"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item">

            <!-- ICON -->

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#00D9FF"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- TEXT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VALIDATE ISSUE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Review reported civic issues"
                    android:textColor="#687586"
                    android:textSize="8sp" />

            </LinearLayout>


            <!-- ARROW -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#00D9FF"
                android:textSize="24sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- FLEXIBLE SPACE -->
        <!-- ===================================================== -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- ===================================================== -->
        <!-- SYSTEM HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingBottom="10dp"
            android:text="SYSTEM"
            android:textColor="#526071"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />


        <!-- ===================================================== -->
        <!-- LOGOUT -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_logout_nav">


            <!-- POWER ICON -->

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⏻"
                android:textColor="#FF3B5C"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- LOGOUT TEXT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOGOUT"
                    android:textColor="#FF3B5C"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Terminate current session"
                    android:textColor="#79505B"
                    android:textSize="8sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>