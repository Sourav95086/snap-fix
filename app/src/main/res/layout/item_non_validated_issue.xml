<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="15dp"
    android:background="@drawable/bg_issue_card">


    <!-- TOP ROW -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvIssueId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#64"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReporter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="Sanjay Das"
            android:textColor="#E9F2F8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="NOT VALIDATED"
            android:textColor="#FFB74D"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pending_badge" />

    </LinearLayout>


    <!-- DESCRIPTION -->

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="Overflowing garbage bin on roadside"
        android:textColor="#DCE5EC"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />


    <!-- LOCATION -->

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Location  •  Tulsipur, Cuttack"
        android:textColor="#8D9AAA"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />


    <!-- LANDMARK -->

    <TextView
        android:id="@+id/tvLandmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Landmark  •  Near Tulsipur Square"
        android:textColor="#718094"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />


    <!-- DIVIDER -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#1A2A36" />


    <!-- DATE -->

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="19 Sep 2026  •  09:10 AM"
        android:textColor="#536477"
        android:textSize="10sp" />

</LinearLayout>