<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:fillViewport="true">

    <!-- ONLY ONE DIRECT CHILD OF SCROLLVIEW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTHLY CONTEST"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CIVIC REPORTER LEADERBOARD"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>


            <!-- LOCATION -->

            <TextView
                android:id="@+id/locationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BHUBANESWAR"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/contest_location_bg"/>

        </LinearLayout>


        <!-- MONTH -->

        <TextView
            android:id="@+id/monthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEPTEMBER 2026"
            android:textColor="#71869B"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="16dp"/>


        <!-- ================================================= -->
        <!-- SCORE MATRIX HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTEST SCORE MATRIX"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>


        <!-- ================================================= -->
        <!-- SCORE MATRIX -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/contest_matrix_bg"
            android:padding="10dp"
            android:layout_marginBottom="20dp">


            <!-- ================= ROW 1 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">


                <!-- TOTAL ISSUES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:background="@drawable/contest_stat_bg"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL ISSUES"
                        android:textColor="#6F8499"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/totalIssuesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>


                <!-- UNIQUE REPORTERS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:background="@drawable/contest_stat_bg"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UNIQUE REPORTERS"
                        android:textColor="#6F8499"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/totalReportersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- DIVIDER -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#172638"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>


            <!-- ================= ROW 2 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">


                <!-- TOP REPORTS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:background="@drawable/contest_stat_bg"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOP REPORTS"
                        android:textColor="#6F8499"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/topReportsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#00E5FF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>


                <!-- WINNERS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:background="@drawable/contest_stat_bg"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WINNERS"
                        android:textColor="#6F8499"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/winnersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="#00E5FF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TOP REPORTERS HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="9dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOP REPORTERS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP 3"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================================================= -->
        <!-- WINNER LIST -->
        <!-- ================================================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/winnersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WINNERS ARE DETERMINED BY VERIFIED CIVIC REPORTS"
            android:textColor="#52677B"
            android:textSize="8sp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/reevaluateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="RE-EVALUATE RESULTS"
            android:textColor="#06111C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/reevaluate_button_bg"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</ScrollView>