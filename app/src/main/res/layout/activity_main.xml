<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">


    <!-- ========================================================= -->
    <!-- SCROLLABLE MAP DASHBOARD                                  -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="94dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="48dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SnapFix"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/cityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Bhubaneswar • Civic Hotspots"
                        android:textColor="#7F8A9A"
                        android:textSize="10sp"/>

                </LinearLayout>


                <TextView
                    android:id="@+id/mapRefresh"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_demo_chip"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="#00D9FF"
                    android:textSize="20sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MAP                                                -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_demo_card"
                android:clipToOutline="true">

                <org.maplibre.android.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>


                <!-- MAP STATUS -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_demo_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_low_badge"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="LIVE HOTSPOTS"
                        android:textColor="#D7DEE8"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- MAP LEGEND -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_demo_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● HOT"
                        android:textColor="#EF4444"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="● MOD"
                        android:textColor="#FACC15"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="● LOW"
                        android:textColor="#22C55E"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </FrameLayout>


            <!-- ================================================= -->
            <!-- ACTIVITY STATUS                                    -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ACTIVITY STATUS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>


            <!-- FILTERS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_demo_chip"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="ALL"
                        android:textColor="#00D9FF"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/filterHotspot"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_demo_chip"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="HOTSPOT"
                        android:textColor="#7F8A9A"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/filterModerate"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_demo_chip"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="MODERATE"
                        android:textColor="#7F8A9A"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/filterLow"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_demo_chip"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="LOW"
                        android:textColor="#7F8A9A"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- SUMMARY                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_demo_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORIES"
                        android:textColor="#697585"
                        android:textSize="8sp"/>

                    <TextView
                        android:id="@+id/categoryCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_demo_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REPORTS"
                        android:textColor="#697585"
                        android:textSize="8sp"/>

                    <TextView
                        android:id="@+id/reportCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#00D9FF"
                        android:textSize="19sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_demo_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOTSPOTS"
                        android:textColor="#697585"
                        android:textSize="8sp"/>

                    <TextView
                        android:id="@+id/hotspotCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#EF4444"
                        android:textSize="19sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACTIVE HOTSPOTS                                   -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTIVE HOTSPOTS"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/activeCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#687484"
                    android:textSize="9sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DYNAMIC CATEGORY CARDS                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>


            <!-- ================================================= -->
            <!-- SELECTED CATEGORY INFO                            -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/categoryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_demo_card"
                android:padding="12dp"
                android:text="Select a hotspot to view details."
                android:textColor="#8792A2"
                android:textSize="9sp"/>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION                                         -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">


        <!-- MAP -->

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconMap"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Map"
                android:src="@drawable/ic_map"/>

            <TextView
                android:id="@+id/textMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAP"
                android:textColor="#00D9FF"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- DEMOGRAPHICS -->

        <LinearLayout
            android:id="@+id/navDemographics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconDemographics"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Demographics"
                android:src="@drawable/ic_demographics"/>

            <TextView
                android:id="@+id/textDemographics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEMOGRAPHICS"
                android:textColor="#777777"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- SOLUTIONS -->

        <LinearLayout
            android:id="@+id/navSolutions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconSolutions"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Solutions"
                android:src="@drawable/ic_solutions"/>

            <TextView
                android:id="@+id/textSolutions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOLUTIONS"
                android:textColor="#777777"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>