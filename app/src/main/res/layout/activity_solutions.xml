<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvSolutionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strategic Solutions"
            android:layout_marginLeft="25dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSolutionsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="25dp"
            android:text="Prioritized civic interventions"
            android:textColor="#8B95A7"
            android:textSize="14sp"/>

    </LinearLayout>


    <!-- SUMMARY -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">


        <!-- TOTAL -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_solution_card">

            <TextView
                android:id="@+id/tvTotalSolutions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#00D9FF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solutions"
                android:textColor="#8B95A7"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- HIGH -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_solution_card">

            <TextView
                android:id="@+id/tvHighPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FF4D5A"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Priority"
                android:textColor="#8B95A7"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- AVERAGE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_solution_card">

            <TextView
                android:id="@+id/tvAverageScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FACC15"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg Score"
                android:textColor="#8B95A7"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ERROR -->

    <TextView
        android:id="@+id/tvSolutionsError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:textColor="#FF5C67"
        android:textSize="13sp"
        android:visibility="gone"/>


    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/progressSolutions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>


    <!-- SOLUTIONS -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/solutionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"/>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <include
        layout="@layout/bottom_navigation"/>

</LinearLayout>