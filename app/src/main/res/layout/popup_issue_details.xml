<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_demo_popup">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCIDENT CONTEXT"
                    android:textColor="#00D9FF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPopupCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Road Infrastructure"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2" />

            </LinearLayout>


            <!-- PRIORITY BADGE -->

            <TextView
                android:id="@+id/tvPopupPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="HIGH"
                android:textColor="#FF5A66"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_popup_badge" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LOCATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPopupLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Bhubaneswar"
                android:textColor="#AAB5C5"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPopupWard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARD 12"
                android:textColor="#00D9FF"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DIVIDER -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#243142" />


        <!-- ================================================= -->
        <!-- DEMOGRAPHIC STATS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPopupScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRIORITY SCORE 82"
                android:textColor="#00D9FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPopupReports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOCAL REPORTS 18"
                android:textColor="#AAB5C5"
                android:textSize="9sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPopupPopulation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="POPULATION 42.5K"
                android:textColor="#AAB5C5"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvPopupDensity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DENSITY 4200/km²"
                android:textColor="#AAB5C5"
                android:textSize="9sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HOTSPOT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvPopupHotspot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HOTSPOT 82 • 18 reports"
            android:textColor="#AAB5C5"
            android:textSize="9sp" />


        <!-- ================================================= -->
        <!-- REASONING -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PRIORITY REASONING"
            android:textColor="#00D9FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvPopupReasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Demographic analysis..."
            android:textColor="#D5DCE5"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISSUE ID  "
                android:textColor="#7F8B9A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPopupIssueId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123"
                android:textColor="#00D9FF"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KEY FACTORS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="KEY FACTORS"
            android:textColor="#00D9FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvPopupFactors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Population • Density • Local reports"
            android:textColor="#8F9BAA"
            android:textSize="9sp"
            android:maxLines="3" />


        <!-- ================================================= -->
        <!-- ISSUE DETAILS BUTTON -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/btnIssueDetails"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="VIEW ISSUE DETAILS"
            android:textColor="#00141A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_popup_issue_button"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


</ScrollView>